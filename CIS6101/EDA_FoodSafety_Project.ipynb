# -------------------------------------------------
# EDA on DOHMH + IoT merged dataset
# -------------------------------------------------

import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Set visualization style
sns.set(style="whitegrid", palette="muted", font_scale=1.1)

# -------------------------------------------------
# 1. Load Dataset
# -------------------------------------------------
df = pd.read_csv("merged_inspection_iot_data_full.csv")

print("Dataset shape:", df.shape)
print("\nColumns:", df.columns.tolist())

# -------------------------------------------------
# 2. Data Overview
# -------------------------------------------------
print("\nMissing values per column:")
print(df.isnull().sum())

print("\nBasic statistics (numeric only):")
print(df.describe())

# -------------------------------------------------
# 3. Inspection Score & Grade Distribution
# -------------------------------------------------
plt.figure(figsize=(8,5))
sns.histplot(df['SCORE'].dropna(), bins=30, kde=True, color="skyblue")
plt.title("Distribution of Inspection Scores")
plt.xlabel("Score")
plt.ylabel("Count")
plt.show()

plt.figure(figsize=(6,4))
sns.countplot(x="GRADE", data=df, order=df['GRADE'].dropna().unique())
plt.title("Distribution of Restaurant Grades")
plt.show()

# -------------------------------------------------
# 4. Violation Patterns
# -------------------------------------------------
if "VIOLATION CODE" in df.columns:
    top_violations = df['VIOLATION CODE'].value_counts().head(10)
    plt.figure(figsize=(10,6))
    sns.barplot(x=top_violations.values, y=top_violations.index, palette="viridis")
    plt.title("Top 10 Most Frequent Violation Codes")
    plt.xlabel("Count")
    plt.ylabel("Violation Code")
    plt.show()

# -------------------------------------------------
# 5. IoT Sensor Variables
# -------------------------------------------------
iot_vars = ["Temperature_F","Humidity_percent","Air_Quality_Index","Surface_Score"]

df[iot_vars].hist(bins=20, figsize=(10,8), color="lightcoral")
plt.suptitle("Distribution of IoT Sensor Readings")
plt.show()

# -------------------------------------------------
# 6. IoT vs Inspection Outcomes
# -------------------------------------------------
plt.figure(figsize=(8,6))
sns.boxplot(x="Risk_Flag", y="SCORE", data=df, order=["normal","warning","high"])
plt.title("Inspection Scores by IoT Risk Category")
plt.show()

plt.figure(figsize=(10,8))
corr = df[iot_vars + ["SCORE"]].corr()
sns.heatmap(corr, annot=True, cmap="coolwarm", center=0)
plt.title("Correlation: IoT Variables vs Inspection Score")
plt.show()

# -------------------------------------------------
# 7. Borough-Level Analysis
# -------------------------------------------------
plt.figure(figsize=(8,5))
sns.countplot(x="BORO", hue="GRADE", data=df, order=df['BORO'].value_counts().index)
plt.title("Grades by Borough")
plt.legend(title="Grade")
plt.show()

# -------------------------------------------------
# 8. Temporal Analysis - Inspections
# -------------------------------------------------
df['INSPECTION DATE'] = pd.to_datetime(df['INSPECTION DATE'], errors="coerce")
df['Timestamp'] = pd.to_datetime(df['Timestamp'], errors="coerce")

df['Inspection_Year'] = df['INSPECTION DATE'].dt.year
df['Inspection_Month'] = df['INSPECTION DATE'].dt.to_period('M')

monthly_counts = df.groupby('Inspection_Month')['CAMIS'].count()
monthly_counts.plot(kind="line", marker="o", figsize=(12,5), color="purple")
plt.title("Monthly Trend of Inspections")
plt.xlabel("Month")
plt.ylabel("Number of Inspections")
plt.show()

monthly_scores = df.groupby('Inspection_Month')['SCORE'].mean()
monthly_scores.plot(kind="line", marker="o", figsize=(12,5), color="darkred")
plt.title("Average Inspection Score by Month")
plt.xlabel("Month")
plt.ylabel("Average Score")
plt.show()

# -------------------------------------------------
# 9. Temporal Analysis - IoT Readings
# -------------------------------------------------
df['IoT_Date'] = df['Timestamp'].dt.date
df['IoT_Hour'] = df['Timestamp'].dt.hour

daily_iot = df.groupby('IoT_Date')[iot_vars].mean()
daily_iot.plot(figsize=(12,8), subplots=True, title=["Daily Avg Temperature","Daily Avg Humidity","Daily Avg Air Quality","Daily Avg Surface Score"])
plt.tight_layout()
plt.show()

plt.figure(figsize=(10,6))
sns.lineplot(x="IoT_Hour", y="Temperature_F", data=df, ci=None, label="Temperature")
sns.lineplot(x="IoT_Hour", y="Humidity_percent", data=df, ci=None, label="Humidity")
plt.title("Hourly IoT Patterns (Temperature & Humidity)")
plt.xlabel("Hour of Day")
plt.ylabel("Average Value")
plt.legend()
plt.show()
